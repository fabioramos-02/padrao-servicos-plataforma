   "lineHeight": 1.25,
   "link": null,
   "locked": false,
   "opacity": 100,
   "originalText": "XVIA (raiz)\nRepositórios da plataforma: SmartPass, X-Forms, X-Flows,\nCMS, Portal, Orquestrador e Design System\nSó a X-VIA e a SETDIG mantêm\nVariáveis da pipeline protegidas e mascaradas\nO template lê o Design System com token só de leitura",
   "roughness": 1,
   "roundness": null,
   "seed": 1825734214,
   "strokeColor": "#244061",
   "strokeStyle": "solid",
   "strokeWidth": 1,
   "text": "XVIA (raiz)\nRepositórios da plataforma: SmartPass, X-Forms, X-Flows,\nCMS, Portal, Orquestrador e Design System\nSó a X-VIA e a SETDIG mantêm\nVariáveis da pipeline protegidas e mascaradas\nO template lê o Design System com token só de leitura",
   "textAlign": "center",
   "updated": 1795552740754,
   "version": 2,
